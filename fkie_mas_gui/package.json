{
  "name": "fkie-mas-gui",
  "version": "5.10.2",
  "description": "GUI to manage running ROS components",
  "license": "MIT",
  "author": "Alexander Tiderko <alexander.tiderko@fkie.fraunhofer.de>",
  "contributors": [
    "Alexander Tiderko <alexander.tiderko@fkie.fraunhofer.de>",
    "Carlos Tampier <carlos.tampier.cotoras@fkie.fraunhofer.de>",
    "Bjarne Jungholt",
    "Francisco Garcia"
  ],
  "homepage": "https://github.com/fkie/fkie-multi-agent-suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/fkie/fkie-multi-agent-suite"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "format": "biome check --write .",
    "lint": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "server:ns": "electron-vite dev -- --no-sandbox --headless",
    "start": "electron-vite preview",
    "start:ns": "electron-vite preview -- --no-sandbox",
    "dev": "electron-vite dev -- --trace-warnings",
    "dev:ns": "electron-vite dev -- --no-sandbox --trace-warnings",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:linux:publish": "electron-vite build && electron-builder --linux --publish always"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/compat": "^1.4.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-tree-view": "^8.29.2",
    "@react-hook/debounce": "^4.0.0",
    "@types/ssh2": "^1.15.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "electron-log": "^5.4.4",
    "electron-settings": "^4.0.4",
    "electron-updater": "^6.8.9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "flexlayout-react": "^0.10.4",
    "hostile": "^1.4.0",
    "idb": "^8.0.3",
    "json5": "^2.2.3",
    "jtest": "^0.0.1",
    "monaco-editor": "^0.56.0",
    "notistack": "^3.0.2",
    "react-app-polyfill": "^3.0.0",
    "react-custom-events": "^1.1.1",
    "react-draggable": "^4.7.1",
    "react-file-icon": "^1.6.0",
    "react-json-tree": "^0.20.0",
    "react-router-dom": "^6.30.4",
    "react-virtuoso": "^4.18.11",
    "react-window": "^1.8.11",
    "react18-json-view": "^0.2.10",
    "shell-quote": "^1.10.0",
    "split-pane-react": "^0.1.3",
    "ssh2": "^1.17.0",
    "systeminformation": "^5.33.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.10.5",
    "electron-builder": "^26.15.7",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vite-plugin-monaco-editor": "^1.1.0"
  }
}
